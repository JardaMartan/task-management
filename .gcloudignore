# .gcloudignore — replaces .gitignore for `gcloud builds submit`
# (if this file exists, .gitignore is NOT used automatically)
.gcloudignore
tmp/
node_modules/
build/
coverage/
*.log
*.env
.DS_Store

# Skip only the non-standalone dev bundle (externalizes React; never served from
# gcloud). The standalone bundles ARE served from /dist/ and referenced by the
# Desktop layout JSON, so they must be uploaded:
#   dist/task-management-standalone.js  → served at /dist/task-management-standalone.js
#   dist/bulk-reskill-standalone.js     → served at /dist/bulk-reskill-standalone.js
#   dist/panel-layout-headless.js, dist/crm-sync-header.js → header/headless widgets
#   dist/crm-clicktocall-extension.zip  → downloadable extension package
dist/task-management.js
