# Cloud Function environment variables
# Copy to .env and fill in your values. Never commit .env to version control.

# Gmail push notification target
PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gmail-inbound
SUPPORT_EMAIL=support@yourcompany.com

# Webex Connect webhook URL to receive inbound emails
WEBEX_CONNECT_INBOUND_WEBHOOK=https://inbound.us1.webexconnect.io/v1/your-webhook-id

# AI enrichment provider: gemini | openai
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-2.5-flash

# CORS origin for token broker (set to your widget host in production)
CORS_ORIGIN=*

# Google service account credentials (path to JSON key file, or use ADC in Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Knowledge base crawl → Vertex AI Search (Discovery Engine) ───────────────
# Target GCP project (defaults to the function's own project via ADC)
GCP_PROJECT=your-project-id
# Discovery Engine location: global | us | eu (eu keeps EU data residency)
VAIS_LOCATION=eu
# Data store id + display name (created automatically on first run)
VAIS_DATA_STORE_ID=innogy-pece
VAIS_DATA_STORE_NAME=Innogy Péče Knowledge Base
# GCS bucket used to stage crawled content before import (must already exist)
VAIS_BUCKET=your-project-innogy-pece
VAIS_GCS_PREFIX=innogy-pece

# Crawler tuning
CRAWL_SEED_URL=https://www.innogy.cz/pece/
CRAWL_MAX_PAGES=120
CRAWL_DELAY_MS=400
# Optional shared secret guarding the HTTP trigger (sent as X-Trigger-Token)
CRAWL_TRIGGER_TOKEN=
