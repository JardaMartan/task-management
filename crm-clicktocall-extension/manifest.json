{
  "manifest_version": 3,
  "name": "Webex CC — CRM Click-to-Contact",
  "version": "0.3.3",
  "description": "Scans third-party CRM pages for email/phone contacts and injects call, SMS and email buttons that drive the Webex CC Desktop widget.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["contact-scan.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CRM Click-to-Contact"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
